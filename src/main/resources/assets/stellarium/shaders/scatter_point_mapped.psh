#version 120

varying vec4 color;

// Radial falloff. 1.12 uses the separable tent 4*min(u,1-u)*min(v,1-v), but the product of
// two 1D tents is a square with soft corners, which reads as a blurred box rather than a star.
// smoothstep's edges must be increasing - writing smoothstep(1.0, 0.0, r2) is undefined
// behaviour and silently blanked the dense star fields.
void main()
{
    vec2 p = gl_TexCoord[0].st * 2.0 - 1.0;
    float r2 = dot(p, p);
    gl_FragColor = color * (1.0 - smoothstep(0.0, 1.0, r2));
}
