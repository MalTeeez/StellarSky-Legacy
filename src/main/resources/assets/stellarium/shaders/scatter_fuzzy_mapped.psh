#version 120

uniform float scaledRadius; // radius / particleSize

varying vec4 color;

const vec2 center = vec2(0.5, 0.5);

// Radial halo: 1.0 over the body's own disc, fading to 0 at the quad edge. The tent form
// this replaces is the product of two 1D ramps, which makes a square with soft corners - the
// "blurred box" that showed up around bright bodies.
void main()
{
    float r = length(gl_PointCoord - center) * 2.0;
    gl_FragColor = color * (1.0 - smoothstep(scaledRadius, 1.0, r));
}
